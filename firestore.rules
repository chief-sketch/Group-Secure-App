rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function isBootstrapAdmin() {
      return signedIn() &&
        request.auth.token.email == 'dmbogo20@gmail.com';
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return isBootstrapAdmin() || (hasProfile() && me().status == 'approved');
    }
    function isApprovedAdmin() {
      return isBootstrapAdmin() ||
        (hasProfile() && me().status == 'approved' && me().role == 'admin');
    }

    function member(channelId) {
      return approved() && hasProfile() && (
        me().channels.hasAny([channelId]) ||
        (channelId == 'general' && me().channels.hasAny(['General', 'general', '# General'])) ||
        (channelId == 'finance' && me().channels.hasAny(['Finance Team', 'finance', '# Finance Team'])) ||
        (channelId == 'it-support' && me().channels.hasAny(['IT Support', 'it-support', '# IT Support'])) ||
        (channelId == 'executive-board' && me().channels.hasAny(['Executive Board', 'executive-board', '# Executive Board']))
      );
    }

    function historyFrom(channelId) {
      return me().get('historyFrom', {}).get(channelId,
        channelId == 'general' ? me().get('historyFrom', {}).get('General', timestamp.date(1970, 1, 1)) :
        channelId == 'finance' ? me().get('historyFrom', {}).get('Finance Team', timestamp.date(1970, 1, 1)) :
        channelId == 'it-support' ? me().get('historyFrom', {}).get('IT Support', timestamp.date(1970, 1, 1)) :
        channelId == 'executive-board' ? me().get('historyFrom', {}).get('Executive Board', timestamp.date(1970, 1, 1)) :
        timestamp.date(1970, 1, 1)
      );
    }

    function isSender() { return resource.data.senderId == request.auth.uid; }

    function validEdit() {
      return isSender() &&
        resource.data.get('deleted', false) == false &&
        request.time < resource.data.createdAt + duration.value(15, 'm') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 4000 &&
        request.resource.data.editedAt == request.time;
    }

    function validSoftDelete() {
      return isSender() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'deletedAt']) &&
        request.resource.data.deleted == true &&
        request.resource.data.text == '' &&
        request.resource.data.deletedAt == request.time;
    }

    function validModeratorDelete() {
      return isApprovedAdmin() &&
        resource.data.get('deleted', false) == false &&
        resource.data.senderId != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleted', 'text', 'deletedAt', 'deletedBy', 'deletedReason']) &&
        request.resource.data.deleted == true &&
        request.resource.data.text == '' &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.deletedBy == 'admin' &&
        request.resource.data.deletedReason is string &&
        request.resource.data.deletedReason.size() <= 60;
    }

    function validMessageCreate() {
      return request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt', 'deliveredTo', 'readBy']) &&
        request.resource.data.keys().hasOnly([
          'senderId', 'senderName', 'text', 'createdAt', 'deliveredTo', 'readBy',
          'replyTo', 'type', 'fileId', 'fileName', 'fileType', 'fileSize', 'thumb'
        ]) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() <= 120 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 4000 &&
        (request.resource.data.text.size() >= 1 ||
         request.resource.data.get('type', 'text') == 'file') &&
        (request.resource.data.get('type', 'text') != 'file' || (
           request.resource.data.fileId is string &&
           request.resource.data.fileName is string &&
           request.resource.data.fileName.size() <= 120 &&
           request.resource.data.fileType is string &&
           request.resource.data.fileSize is number &&
           request.resource.data.fileSize <= 700000 &&
           request.resource.data.text.size() <= 500)) &&
        request.resource.data.deliveredTo is list &&
        request.resource.data.deliveredTo.hasOnly([request.auth.uid]) &&
        request.resource.data.readBy is list &&
        request.resource.data.readBy.hasOnly([request.auth.uid]) &&
        request.resource.data.createdAt == request.time &&
        (!('thumb' in request.resource.data) ||
            (request.resource.data.thumb is string && request.resource.data.thumb.size() <= 35000)) &&
        (!('replyTo' in request.resource.data) ||
            (request.resource.data.replyTo is map &&
             request.resource.data.replyTo.keys().hasOnly(['messageId', 'senderName', 'preview']) &&
             request.resource.data.replyTo.messageId is string &&
             request.resource.data.replyTo.preview is string &&
             request.resource.data.replyTo.preview.size() <= 140));
    }

    function validFileDoc() {
      return request.resource.data.senderId == request.auth.uid &&
        request.resource.data.fileName is string &&
        request.resource.data.fileName.size() <= 120 &&
        request.resource.data.fileType in [
          'image/png', 'image/jpeg', 'image/webp', 'image/gif',
          'application/pdf', 'text/plain', 'text/csv',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        ] &&
        request.resource.data.fileSize is number &&
        request.resource.data.fileSize <= 700000 &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 900000 &&
        request.resource.data.createdAt == request.time;
    }

    // Receipts: only deliveredTo and readBy may change, and a user may only add
    // their own uid, never remove entries or add other people.
    function validReceiptUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deliveredTo', 'readBy']) &&
        request.resource.data.deliveredTo is list &&
        request.resource.data.readBy is list &&
        request.resource.data.deliveredTo.toSet()
          .difference(resource.data.deliveredTo.toSet()).hasOnly([request.auth.uid]) &&
        request.resource.data.readBy.toSet()
          .difference(resource.data.readBy.toSet()).hasOnly([request.auth.uid]) &&
        resource.data.deliveredTo.toSet()
          .difference(request.resource.data.deliveredTo.toSet()).size() == 0 &&
        resource.data.readBy.toSet()
          .difference(request.resource.data.readBy.toSet()).size() == 0;
    }

    function meetingFieldsOk(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 100 &&
        d.startsAt is timestamp &&
        d.durationMinutes is number && d.durationMinutes >= 5 && d.durationMinutes <= 480 &&
        d.get('link', '').size() <= 200 &&
        d.get('location', '').size() <= 120 &&
        d.get('note', '').size() <= 300;
    }

    function validMeetingCreate() {
      return meetingFieldsOk(request.resource.data) &&
        request.resource.data.keys().hasOnly(['title', 'startsAt', 'durationMinutes', 'link',
          'location', 'note', 'status', 'createdBy', 'createdByName', 'createdAt', 'rsvp']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.startsAt > request.time &&
        request.resource.data.status == 'scheduled' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.rsvp is map;
    }

    function validMeetingEdit() {
      return resource.data.createdBy == request.auth.uid &&
        resource.data.status == 'scheduled' &&
        meetingFieldsOk(request.resource.data) &&
        request.resource.data.startsAt > request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'startsAt', 'durationMinutes', 'link', 'location', 'note', 'editedAt']) &&
        request.resource.data.editedAt == request.time;
    }

    function validRsvpUpdate() {
      return resource.data.status == 'scheduled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp']) &&
        request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys()
          .hasOnly([request.auth.uid]) &&
        request.resource.data.rsvp[request.auth.uid] in ['going', 'maybe', 'declined'];
    }

    function validMeetingCancel() {
      return (resource.data.createdBy == request.auth.uid || isApprovedAdmin()) &&
        resource.data.status == 'scheduled' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledBy', 'cancelledAt']) &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.cancelledBy == request.auth.uid &&
        request.resource.data.cancelledAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isApprovedAdmin();
      allow list: if isApprovedAdmin();
      allow create: if isOwner(userId) && (
        (request.resource.data.role == 'staff' &&
         request.resource.data.status == 'pending' &&
         request.resource.data.channels.size() == 0 &&
         !('historyFrom' in request.resource.data)) ||
        (isBootstrapAdmin() &&
         request.resource.data.role == 'admin' &&
         request.resource.data.status == 'approved')
      );
      allow update: if isApprovedAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'channels', 'email', 'historyFrom'])
      );
      allow delete: if isApprovedAdmin();

      match /myMeetings/{meetingId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /auditLogs/{logId} {
      allow get, list: if isApprovedAdmin();
      allow create: if approved() && (
        isApprovedAdmin() || (
          request.resource.data.keys().hasAll(['id', 'timestamp', 'actor', 'action', 'details', 'category', 'actorUid', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['id', 'timestamp', 'actor', 'action', 'details', 'category', 'actorUid', 'createdAt', 'type']) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.id is string &&
          request.resource.data.id.size() >= 1 &&
          request.resource.data.id.size() <= 100 &&
          request.resource.data.timestamp is string &&
          request.resource.data.timestamp.size() <= 60 &&
          request.resource.data.actor is string &&
          request.resource.data.actor.size() >= 1 &&
          request.resource.data.actor.size() <= 120 &&
          (!hasProfile() || (
            request.resource.data.actor == me().get('fullName', '') ||
            request.resource.data.actor == me().get('email', '') ||
            request.resource.data.actor == request.auth.token.email
          )) &&
          request.resource.data.action is string &&
          request.resource.data.action.size() <= 200 &&
          request.resource.data.details is string &&
          request.resource.data.details.size() <= 500 &&
          request.resource.data.category in ['Auth', 'Role change', 'Approval', 'Retention', 'Purge', 'Moderation'] &&
          (!('type' in request.resource.data) || (request.resource.data.type is string && request.resource.data.type.size() <= 40)) &&
          request.resource.data.createdAt == request.time
        )
      );
      allow update: if false;
      allow delete: if isApprovedAdmin();
    }

    match /retentionPolicies/{policyId} {
      allow read: if approved();
      allow write: if isApprovedAdmin();
    }

    match /directory/{uid} {
      allow read: if approved();
      allow create: if isApprovedAdmin() || (
        approved() && isOwner(uid) && !('channels' in request.resource.data)
      );
      allow update: if isApprovedAdmin() || (
        approved() && isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['channels'])
      );
      allow delete: if isApprovedAdmin();
    }

    match /channels/{channelId} {
      allow read: if approved();
      allow write: if isApprovedAdmin();

      match /messages/{messageId} {
        allow read: if member(channelId) &&
          resource.data.createdAt >= historyFrom(channelId);
        allow create: if member(channelId) && validMessageCreate();
        allow update: if (member(channelId) && (validReceiptUpdate() || validEdit() || validSoftDelete())) ||
          (isApprovedAdmin() && validModeratorDelete());
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if member(channelId);
        allow create, update: if member(channelId) && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['name', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if member(channelId) && request.auth.uid == uid;
      }

      match /files/{fileId} {
        allow get: if member(channelId) &&
          resource.data.createdAt >= historyFrom(channelId);
        allow list: if false;
        allow create: if member(channelId) && validFileDoc();
        allow update: if false;
        allow delete: if member(channelId) &&
          (resource.data.senderId == request.auth.uid || isApprovedAdmin());
      }

      match /meetings/{meetingId} {
        allow read: if member(channelId);
        allow create: if member(channelId) && validMeetingCreate();
        allow update: if member(channelId) &&
          (validMeetingEdit() || validRsvpUpdate() || validMeetingCancel());
        allow delete: if false;
      }
    }

    match /directChats/{chatId} {
      // resource == null lets the app check whether a chat exists before creating it
      allow get: if approved() &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow list: if approved() && request.auth.uid in resource.data.participants;
      allow create: if approved() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] is string &&
        request.resource.data.participants[1] is string &&
        ((request.resource.data.participants[0] < request.resource.data.participants[1] &&
          chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]) ||
         (request.resource.data.participants[1] < request.resource.data.participants[0] &&
          chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]));
      // participants can never change after creation
      allow update: if approved() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow create: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          validMessageCreate();
        allow update: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          (validReceiptUpdate() || validEdit() || validSoftDelete());
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow create, update: if approved() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          request.resource.data.keys().hasOnly(['name', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if approved() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
      }

      match /files/{fileId} {
        allow get: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow list: if false;
        allow create: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          validFileDoc();
        allow update: if false;
        allow delete: if approved() && resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
      }

      match /meetings/{meetingId} {
        allow read: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow create: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          validMeetingCreate();
        allow update: if approved() &&
          request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants &&
          (validMeetingEdit() || validRsvpUpdate() || validMeetingCancel());
        allow delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if approved() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 500 &&
        request.resource.data.status == 'open';
      allow get, list: if isApprovedAdmin();
      allow update: if isApprovedAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /historyRequests/{requestId} {
      allow create: if approved() &&
        request.resource.data.uid == request.auth.uid &&
        requestId == request.auth.uid + '_' + request.resource.data.channelId &&
        request.resource.data.status == 'open' &&
        request.resource.data.note.size() <= 200;
      allow get, list: if isApprovedAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isApprovedAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
